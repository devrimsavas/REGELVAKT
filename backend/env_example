# Development settings: copy to backend/.env
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=regelvakt
DB_USER=postgres
DB_PASSWORD=

# Signs the manage links in reminder emails. At least 32 characters; make
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it breaks the links in emails already sent.
SUBSCRIPTION_SECRET=

# Email. EMAIL_PROVIDER is "log" (write emails to the terminal, the default)
# or "resend" (send them with https://resend.com, needs RESEND_API_KEY).
# WEB_APP_URL is where the links in emails point.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Regelvakt <onboarding@resend.dev>
WEB_APP_URL=http://localhost:3001
# The reminder job runs once a day at this hour, Norwegian time (0-23), and
# checks every REMINDER_CHECK_MINUTES whether it is time
EMAIL_HOUR=7
REMINDER_CHECK_MINUTES=15

# Assistant. AI_PROVIDER is "ollama" or "gemini"; leave it empty and the
# assistant answers with the most relevant official sections only.
# Locally: Ollama with a model you have pulled (ollama pull qwen3).
# Live: Gemini with a key from Google AI Studio. The free tier may use the
# questions to improve Google's products; use a paid key for real users.
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=60
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Questions per day for everybody together: a ceiling on the model's cost
ASSISTANT_DAILY_LIMIT=500
# Milliseconds between two requests to the same site when the knowledge
# base is read (be polite: keep it at 1000 or more)
CRAWL_DELAY_MS=1000

# Logging. LOG_FORMAT=pretty writes readable, coloured lines (needs the
# pino-pretty dev dependency); leave it out on a server to get JSON lines.
# LOG_LEVEL is the lowest level written: trace, debug, info, warn, error,
# fatal or silent.
LOG_FORMAT=pretty
LOG_LEVEL=info

# Rate limits per client address, per 15 minutes. Leave out for the defaults.
# BRREG_REQUESTS_PER_ADDRESS counts the requests that look a company up in
# Brreg (company, questions, new assessment).
REQUESTS_PER_ADDRESS=1000
BRREG_REQUESTS_PER_ADDRESS=100
# New reminder subscriptions per hour: from one client address, and for one
# email address from any client (stops filling someone's inbox)
SUBSCRIPTIONS_PER_ADDRESS=20
SUBSCRIPTIONS_PER_EMAIL=5
# Calendar feeds, per client address. Higher than the others: calendar apps
# such as Google Calendar fetch many users' calendars from shared addresses.
CALENDAR_REQUESTS_PER_ADDRESS=5000
# Questions to the assistant per hour, per client address
ASSISTANT_QUESTIONS_PER_ADDRESS=30

# Proxies whose X-Forwarded-For header is trusted for the client's address.
# The default trusts this machine and private networks (the web app, Docker).
# Behind a hosting platform, a number of hops may be needed instead, e.g. 1.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Test settings: copy to backend/.env.test
# The test database name must end with _test; tests empty its tables.
# The tests set SUBSCRIPTION_SECRET, EMAIL_PROVIDER and WEB_APP_URL themselves.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=regelvakt_test
DB_USER=postgres
DB_PASSWORD=
