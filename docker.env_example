# Settings for running Regelvakt with Docker: copy to .env next to
# docker-compose.yml. The database host and port are set by
# docker-compose.yml; everything else is read from here.

# The database Docker creates on the first start. Pick a long password;
# it cannot be changed here afterwards without resetting the database.
DB_NAME=regelvakt
DB_USER=regelvakt
DB_PASSWORD=

# The ports on this machine (127.0.0.1 only) where the web app and the
# API answer. On a server (docker-compose.prod.yml) only WEB_PORT is used,
# 3002 when it is empty; the API has no port there
WEB_PORT=3001
API_PORT=3000
# The header that holds the visitor's address: cf-connecting-ip behind a
# Cloudflare tunnel; empty for the first address in X-Forwarded-For.
# docker-compose.prod.yml uses cf-connecting-ip when it is empty
CLIENT_IP_HEADER=

# Signs the manage links in reminder emails. At least 32 characters; make
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it breaks the links in emails already sent.
SUBSCRIPTION_SECRET=

# Page view counter (web app, docker-compose.prod.yml only): the
# counter's /count address from GoatCounter, such as
# https://regelvakt.goatcounter.com/count. Empty counts nothing.
GOATCOUNTER_URL=

# Email: "log" writes emails to the log, "resend" sends them
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Regelvakt <onboarding@resend.dev>
# Where the links in emails point: the web app's public address
WEB_APP_URL=http://localhost:3001
EMAIL_HOUR=7

# Assistant: "gemini" on a server. Use a paid key for real users: the free
# tier may use the questions to improve Google's products.
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
# The model name as Google AI Studio shows it; without it the assistant
# gives the official sections only
GEMINI_MODEL=
# Or a local Ollama outside Docker:
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma4:12b
ASSISTANT_DAILY_LIMIT=500
CRAWL_DELAY_MS=1000
# "off" stops the weekly update of the knowledge base
KNOWLEDGE_UPDATES=

# JSON log lines, for docker compose logs
LOG_LEVEL=info

# The web app and a reverse proxy reach the API from Docker's private
# network or this machine; their X-Forwarded-For is trusted
TRUST_PROXY=loopback, linklocal, uniquelocal
